NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/agri_commerce?directConnection=true
CORS_ORIGINS=http://localhost:3000

# Generate your own: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-48-random-bytes
OTP_PEPPER=replace-with-32-random-bytes

# Set in production only: ".yourdomain.in" so one cookie covers www + api subdomains
# COOKIE_DOMAIN=

SMS_PROVIDER=console
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=

OTP_DEV_ECHO=true

ADMIN_PHONE=9999999999
ADMIN_PASSWORD="change-me-please"
